# Optional: enables real AI listing generation and the Ask AI assistant. Without it listings use the
# template generator and Ask AI shows "AI not configured". Server-side only – never NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# Optional: override the model used for listings and Ask AI.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Set to 1 to run the UI against the in-browser demo backend (required on Vercel; see README).
NEXT_PUBLIC_DEMO_MODE=
